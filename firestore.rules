rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.superAdmin == true ||
        request.auth.token.admin == true ||
        request.auth.token.role == "superAdmin"
      );
    }

    function ownsOrg(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)).data.adminUid == request.auth.uid;
    }

    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }
    match /defaultQuestions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }
    match /organizations/{orgId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.adminUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.adminUid == request.auth.uid;
      allow update: if isSuperAdmin() || (isSignedIn() && resource.data.adminUid == request.auth.uid);
      allow delete: if isSuperAdmin();
    }
    match /orgEmailLookup/{email} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }
    match /campaigns/{campaignId} {
      allow read: if isSuperAdmin() || ownsOrg(resource.data.orgId);
      allow create: if isSuperAdmin() || ownsOrg(request.resource.data.orgId);
      allow update, delete: if isSuperAdmin() || ownsOrg(resource.data.orgId);
    }
    match /adminSettings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
    match /invites/{inviteId} {
      allow read: if isSuperAdmin() || ownsOrg(resource.data.orgId);
      allow create, update, delete: if isSuperAdmin();
    }
    match /reports/{reportId} {
      allow read: if isSuperAdmin() || ownsOrg(resource.data.orgId);
      allow create, update, delete: if isSuperAdmin();
    }
    match /auditLogs/{auditId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
  }
}
